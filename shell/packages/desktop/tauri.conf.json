{
  "build": {
    "frontendDist": "./frontend"
  },
  "productName": "Logical Lunge Shell",
  "version": "0.0.0",
  "identifier": "com.logicallunge.shell",
  "bundle": {
    "active": false,
    "icon": [
      "resources/icons/32x32.png",
      "resources/icons/128x128.png",
      "resources/icons/128x128@2x.png",
      "resources/icons/icon.ico"
    ],
    "shortDescription": "Logical Lunge Shell",
    "publisher": "Logical Lunge"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "data: blob: *",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true
      }
    }
  }
}
