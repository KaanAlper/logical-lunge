{
    "name": "logical-lunge",
    "version": "1.0.0",
    "description": "Logical Lunge: bar, uygulama arama, yan panel, ayarlar ve bildirimler.",
    "tags": [
        "topbar"
    ],
    "previewImages": [],
    "repositoryUrl": "",
    "widgets": [
        {
            "name": "sidebar-right",
            "htmlPath": "./sidebar.html",
            "zOrder": "top_most",
            "shownInTaskbar": false,
            "focused": false,
            "resizable": false,
            "transparent": true,
            "shownOnStart": false,
            "includeFiles": [
                "*.html",
                "*.css",
                "*.json",
                "*.js",
                "lib/*.js",
                "fonts/*.woff2"
            ],
            "caching": {
                "rules": [
                    {
                        "urlRegex": "apps\\.json",
                        "duration": 0
                    }
                ],
                "defaultDuration": 604800
            },
            "privileges": {
                "shellCommands": [
                    {
                        "program": "explorer",
                        "argsRegex": ".*"
                    },
                    {
                        "program": "powershell",
                        "argsRegex": ".*"
                    },
                    {
                        "program": "cmd",
                        "argsRegex": ".*"
                    },
                    {
                        "program": "rundll32",
                        "argsRegex": ".*"
                    },
                    {
                        "program": "shutdown",
                        "argsRegex": ".*"
                    },
                    {
                        "program": "{{INSTALL_ESC}}\\lunge.exe",
                        "argsRegex": ".*"
                    }
                ]
            },
            "presets": [
                {
                    "name": "default",
                    "anchor": "top_right",
                    "offsetX": "0px",
                    "offsetY": "0px",
                    "width": "460px",
                    "height": "100%",
                    "monitorSelection": {
                        "type": "primary"
                    },
                    "dockToEdge": {
                        "edge": null,
                        "windowMargin": "0px",
                        "enabled": false
                    }
                }
            ]
        }
    ]
}
